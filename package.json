{
  "name": "parichiti-studios-photos",
  "productName": "Parichiti Studios - Passport Photo Studio",
  "version": "2.1.0",
  "description": "Create professional Indian passport, PAN, stamp, and visa photos instantly - 100% free, offline, and private! Windows Desktop App.",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "dev": "NODE_ENV=development electron . --no-sandbox",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:all": "electron-builder --mac --win --linux --publish never"
  },
  "keywords": [
    "passport",
    "photo",
    "generator",
    "visa",
    "pan card",
    "stamp size",
    "parichiti studios",
    "offline",
    "windows app",
    "desktop app",
    "electron"
  ],
  "author": {
    "name": "Sagar Roy",
    "company": "Parichiti Digital Services",
    "url": "https://github.com/thesagarroy"
  },
  "license": "MIT",
  "homepage": "https://thesagarroy.github.io/Parichiti-Studios-Photos/",
  "repository": {
    "type": "git",
    "url": "https://github.com/thesagarroy/Parichiti-Studios-Photos.git"
  },
  "build": {
    "appId": "com.parichiti.passportphoto",
    "productName": "Parichiti Studios - Passport Photo Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "editor.html",
      "print.html",
      "manifest.json",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "lib/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "thesagarroy",
      "repo": "Parichiti-Studios-Photos"
    },
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Parichiti Studios Photo Studio",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "uninstallDisplayName": "Parichiti Studios - Passport Photo Studio",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^39.2.1",
    "electron-builder": "^26.0.12",
    "png2icons": "^2.0.1"
  }
}
